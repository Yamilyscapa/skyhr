# APP
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
APP_URL=http://localhost:3000

# DB
DATABASE_URL=postgresql://user:password@localhost:5432/skyhr

# BETTER_AUTH
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here
# Use http://localhost:8080 for development, https://your-domain.com for production
BETTER_AUTH_URL=http://localhost:8080
# Comma-separated list of allowed origins
TRUSTED_ORIGINS=http://localhost:3000
# Optional: Set cookie domain for cross-subdomain support (e.g., .yourdomain.com)
# COOKIE_DOMAIN=

# QR PAYLOAD SECRET
# Base64 encoded secret for QR code encryption
QR_SECRET="your-qr-secret-here"

# AWS S3 (for production file storage)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET=your-s3-bucket-name

# RATE LIMITING (Railway Redis)
# Railway usually injects REDIS_PRIVATE_URL / REDIS_URL automatically.
# Fallback custom URL for non-Railway or local setups.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_PREFIX=rl:skyhr
# Rotate this salt in production to avoid predictable hashed IP keys.
RATE_LIMIT_IP_SALT=replace-with-a-random-secret
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=1000
RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS=50
RATE_LIMIT_REDIS_RECONNECT_COOLDOWN_MS=5000
RATE_LIMIT_LOCAL_MAX_KEYS=10000

# RESEND (for email sending)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# STRIPE BILLING
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_TIER_1_20=price_tier_1_20
STRIPE_PRICE_TIER_21_50=price_tier_21_50
STRIPE_PRICE_TIER_51_100=price_tier_51_100
STRIPE_PRICE_OVERAGE_101_PLUS=price_overage_101_plus
# Used for monthly estimate math (actual charge uses Stripe price IDs)
STRIPE_OVERAGE_PER_USER_MXN=100
